DOORLOOP_EMAIL=your-email@example.com
DOORLOOP_PASSWORD=your-password
DOORLOOP_URL=https://bansals.app.doorloop.com

# Browser settings
# DOORLOOP_HEADLESS=true
# DOORLOOP_PROFILE_DIR=~/.doorloop-mcp/chrome-profile

# AgentMail — for automated 2FA code retrieval
AGENTMAIL_API_KEY=your-agentmail-api-key
AGENTMAIL_INBOX_ID=your-agentmail-inbox-id

# Claude AI — for vision fallback (Layer 3)
# ANTHROPIC_API_KEY=your-anthropic-key

# SQLite database path (default: ~/.doorloop-mcp/doorloop.sqlite3)
# DOORLOOP_DB_PATH=~/.doorloop-mcp/doorloop.sqlite3

# Payment confirmation emails — sent via AgentMail (requires AGENTMAIL_* above)
# DOORLOOP_CONFIRMATION_EMAIL_TO=manager@example.com
